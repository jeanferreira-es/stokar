{
  "name": "stokar-app",
  "version": "1.1.0",
  "description": "Aplicativo do Stokar: clientes pedem serviços, acompanham e conversam com a oficina; a equipe registra serviços pelo celular",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
