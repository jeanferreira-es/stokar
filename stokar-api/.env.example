# ---------- Aplicação ----------
NODE_ENV=development
PORT=3000
# Origens permitidas (separadas por vírgula) ou * para liberar todas
CORS_ORIGIN=*
# Fuso horário da oficina (datas das notas em PDF e vigência dos contratos)
APP_TIMEZONE=America/Sao_Paulo

# ---------- Banco de dados (PostgreSQL) ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/estoque
# true para provedores que exigem SSL (Neon, Supabase, Vercel Postgres, Render...)
DB_SSL=false
# Executa as migrations pendentes automaticamente ao iniciar (útil na Vercel)
DB_MIGRATIONS_RUN=true
# Apenas para desenvolvimento: cria/alterar tabelas a partir das entidades. NUNCA use em produção.
DB_SYNCHRONIZE=false
# Conexões por instância (mantenha baixo em ambiente serverless)
DB_POOL_MAX=3

# ---------- JWT ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_REFRESH_SECRET=troque-por-outro-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Sessão do aplicativo: renovada a cada uso, só termina ao sair (ou após este tempo sem abrir o app)
JWT_APP_REFRESH_EXPIRES_IN=180d

# ---------- Cadastro ----------
# Se false, apenas ADMIN cria usuários (o primeiro cadastro sempre é permitido e vira ADMIN)
ALLOW_PUBLIC_REGISTRATION=true
# Se true, clientes podem criar a própria conta pelo aplicativo (POST /api/auth/register-client)
ALLOW_CLIENT_REGISTRATION=true

# ---------- Notificações (canais opcionais) ----------
# E-mail via SMTP: deixe SMTP_HOST vazio para desativar
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Estoque <no-reply@exemplo.com>"
# Webhook (Slack, Discord, n8n...): recebe um POST JSON a cada notificação. Vazio = desativado
NOTIFICATION_WEBHOOK_URL=

# ---------- Seed (npm run seed) ----------
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_PASSWORD=
# true cria tipos de serviço e serviços de exemplo (valores zerados) se o catálogo estiver vazio
SEED_SAMPLE_CATALOG=false
