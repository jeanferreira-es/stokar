{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://jeanferreira-es.github.io/stokar/stokar-app/POLITICA_DE_PRIVACIDADE.html",
        "EXPO_PUBLIC_CHAT_POLL_MS": "4000",
        "EXPO_PUBLIC_UNREAD_POLL_MS": "20000"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://jeanferreira-es.github.io/stokar/stokar-app/POLITICA_DE_PRIVACIDADE.html"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
