# URL base da stokar-api (com /api no final).
# No emulador Android, "localhost" é o próprio emulador: use http://10.0.2.2:3000/api
# Em um celular de verdade, use o IP do computador na rede (ex.: http://192.168.0.10:3000/api) ou a URL publicada.
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Endereço público da política de privacidade (o arquivo POLITICA_DE_PRIVACIDADE.md no GitHub)
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://github.com/jeanferreira-es/stokar/blob/main/stokar-app/POLITICA_DE_PRIVACIDADE.md

# Intervalos de consulta, em ms (a API não tem push nem WebSocket)
EXPO_PUBLIC_CHAT_POLL_MS=4000
EXPO_PUBLIC_UNREAD_POLL_MS=20000
